// Local-only Cloudflare bindings for `nuxt dev` (the CMS proof of concept).
//
// Deliberately NOT named wrangler.json/jsonc/toml: Nitro merges a file with
// one of those names into the production deploy config, and this database id
// is a placeholder. When the client signs off, create the real database
// (`wrangler d1 create tmiladzi-cms`), move this block into wrangler.jsonc
// with the id it prints, and add a migrations step to the deploy workflow.
{
  "name": "tmiladzi",
  "compatibility_date": "2025-07-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tmiladzi-cms",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "server/database/migrations"
    }
  ]
}
