// Local-only Cloudflare bindings for `nuxt dev`.
//
// Deliberately NOT named wrangler.json/jsonc/toml: Nitro merges a file with
// one of those names into the production deploy config, and this database id
// is a placeholder. Production gets its database id from the pipeline
// (repo variable CLOUDFLARE_D1_DATABASE_ID, see nuxt.config.ts and
// .github/workflows/deploy.yml).
{
  "name": "tmiladzi",
  "compatibility_date": "2025-07-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tmiladzi-cms",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "server/database/migrations"
    }
  ]
}
